{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sfo1"],
  "functions": {
    "asgi.py": {
      "maxDuration": 60,
      "includeFiles": "{data/philocafe.db,data/resources.yaml,.cache/fastembed/**,personas/**,config.yaml,ui/web/**}",
      "excludeFiles": "{public/**,ui/app.py,ui/web/tools/**,tests/**,eval/**,docs/**,data/processed/**,data/raw/**,scripts/tests/**,.venv/**,**/*.md}"
    }
  },
  "redirects": [
    { "source": "/", "destination": "/index.html", "permanent": false },
    { "source": "/favicon.ico", "destination": "/icons/icon-192.png", "permanent": false }
  ],
  "crons": [{ "path": "/internal/purge", "schedule": "0 10 * * *" }]
}
