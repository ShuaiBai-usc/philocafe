# Copy to .env and fill in. Never commit .env.
# Locally, leave the optional values empty; on Vercel set the same names under
# Settings > Environment Variables (deploy/README.md).

# --- Required ---
ANTHROPIC_API_KEY=
JEV_API_KEY=

# --- Retrieval ---
PHILOCAFE_DB=data/philocafe.db
# Provisional retrieval threshold until calibrated on the 30 test messages
PHILOCAFE_MIN_SCORE=0.3

# --- Deployment (ADR-11); empty means off ---
# Access code the web app asks for once per device; empty = no code (local default)
PHILOCAFE_ACCESS_CODE=
# Postgres for conversation checkpoints; empty = in memory (local default).
# On Vercel, the Neon integration sets DATABASE_URL, which is used when this is empty.
PHILOCAFE_CHECKPOINT_URL=
# Secret the daily Vercel Cron sends to /internal/purge; empty = purge refused
CRON_SECRET=
# How long Postgres keeps a conversation before the purge deletes it
PHILOCAFE_RETENTION_HOURS=24

# --- Development ---
# 1 = the server uses offline stand-ins (no API calls)
PHILOCAFE_FAKE=
